generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  manager
  cashier
  waiter
  kitchen_staff

  @@map("user_role")
}

enum OrderStatus {
  pending
  approved
  preparing
  ready
  completed
  cancelled

  @@map("order_status")
}

enum PaymentMethod {
  cash
  card
  mobile
  other

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded

  @@map("payment_status")
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  cancelled
  expired

  @@map("subscription_status")
}

model PricingPlan {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @db.VarChar(255)
  description String?
  price       Decimal        @db.Decimal(10, 2)
  maxUsers    Int            @default(5)
  maxOrders   Int            @default(1000)
  features    Json           @default("[]") @db.JsonB
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("pricing_plans")
}

model Tenant {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  name          String
  description   String?
  logoUrl       String?  @map("logo_url")
  coverImageUrl String?  @map("cover_image_url")
  primaryColor  String   @default("#6366f1") @map("primary_color")
  accentColor   String   @default("#f59e0b") @map("accent_color")
  customDomain  String?  @unique @map("custom_domain")
  timezone      String   @default("UTC")
  currency      String   @default("USD")
  serviceCharge Decimal  @default(10.00) @map("service_charge") @db.Decimal(5, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users         User[]
  menuItems     MenuItem[]
  categories    Category[]
  tables        Table[]
  orders        Order[]
  payments      Payment[]
  expenses      Expense[]
  invoices      Invoice[]
  conversations Conversation[]
  domains       TenantDomain[]
  staffSchedules StaffSchedule[]
  qrCodes       QrCode[]
  subscription  Subscription?

  @@map("tenants")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String?    @map("tenant_id") @db.Uuid
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  displayName  String     @map("display_name") @db.VarChar(255)
  role         UserRole
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffSchedules StaffSchedule[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
  @@map("categories")
}

model Table {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tableNumber Int      @map("table_number")
  capacity    Int      @default(4)
  qrCode      String?  @map("qr_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tableNumber])
  @@map("tables")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(255)
  price       Decimal  @db.Decimal(10, 2)
  description String   @default("")
  category    String   @db.VarChar(100)
  tags        String[]
  imageUrl    String   @default("/images/default_food.jpg") @map("image_url")
  available   Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category, sortOrder])
  @@map("menu_items")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  orderNumber   Int         @default(autoincrement()) @map("order_number")
  tableNumber   Int         @map("table_number")
  status        OrderStatus @default(pending)
  notes         String      @default("")
  items         Json        @db.JsonB
  subtotal      Decimal     @db.Decimal(10, 2)
  serviceCharge Decimal     @map("service_charge") @db.Decimal(10, 2)
  totalAmount   Decimal     @map("total_amount") @db.Decimal(10, 2)
  createdBy     String?     @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, tableNumber, createdAt(sort: Desc)])
  @@map("orders")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(cash)
  status      PaymentStatus @default(pending)
  reference   String?       @db.VarChar(255)
  processedBy String?       @map("processed_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  description String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(10, 2)
  category    String   @db.VarChar(100)
  date        DateTime @default(now())
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date(sort: Desc)])
  @@map("expenses")
}

model Invoice {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  orderId       String?   @map("order_id") @db.Uuid
  invoiceNumber String    @map("invoice_number") @db.VarChar(50)
  amount        Decimal   @db.Decimal(10, 2)
  tax           Decimal   @default(0) @db.Decimal(10, 2)
  status        String    @default("draft") @db.VarChar(20)
  dueDate       DateTime? @map("due_date")
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@map("invoices")
}

model StaffSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  dayOfWeek Int      @default(0) @map("day_of_week")
  startTime String   @map("start_time") @db.VarChar(5)
  endTime   String   @map("end_time") @db.VarChar(5)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("staff_schedules")
}

model QrCode {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tableId   String?  @map("table_id") @db.Uuid
  url       String   @db.VarChar(500)
  label     String?  @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("qr_codes")
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @unique @map("tenant_id") @db.Uuid
  planId    String             @map("plan_id") @db.Uuid
  status    SubscriptionStatus @default(trialing)
  startDate DateTime           @default(now()) @map("start_date")
  endDate   DateTime?          @map("end_date")
  autoRenew Boolean            @default(true) @map("auto_renew")
  stripeId  String?            @map("stripe_id") @db.VarChar(255)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   PricingPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model FeatureFlag {
  id              String  @id @default(uuid()) @db.Uuid
  key             String  @unique @db.VarChar(100)
  label           String  @db.VarChar(255)
  description     String  @default("")
  enabled         Boolean @default(false)
  tenantOverrides Json    @default("{}") @map("tenant_overrides") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("feature_flags")
}

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  sessionId String   @map("session_id") @db.VarChar(255)
  messages  Json     @default("[]") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("conversations")
}

model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  domain    String   @unique @db.VarChar(255)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_domains")
}
